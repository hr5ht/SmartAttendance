# Copy to .env and edit. Every value here has a working default in settings.py.

# --- core -------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata
INSTITUTION_NAME=Smart Attendance

# --- face model -------------------------------------------------------------
FACE_MODEL_NAME=buffalo_l
FACE_MODEL_ROOT=models
FACE_DET_SIZE=640

# --- matching thresholds ----------------------------------------------------
SIMILARITY_THRESHOLD=0.45
MARGIN_THRESHOLD=0.05
MIN_DETECTION_SCORE=0.50
MIN_FACE_PIXELS=40

# --- enrollment quality gates ----------------------------------------------
ENROLLMENT_STEPS=5
MIN_ENROLL_FACE_PIXELS=120
MIN_ENROLL_DET_SCORE=0.65
MIN_ENROLL_BLUR_VARIANCE=45
DUPLICATE_EMBEDDING_THRESHOLD=0.98

# --- who may take which class ------------------------------------------------
# 1 = a teacher may only take the sections/subjects they are assigned to.
# 0 = any teacher may take any active class (they still only see their own).
RESTRICT_TEACHER_TO_ASSIGNMENTS=0

# --- uploads ----------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=12
MAX_IMAGE_DIMENSION=2400
MAX_SESSION_IMAGES=3

# --- email (console backend is used automatically when DJANGO_DEBUG=1) ------
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Smart Attendance <no-reply@example.edu>
ATTENDANCE_EMAIL_CC=
